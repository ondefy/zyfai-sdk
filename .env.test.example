# Select stack: local (default) | staging | production
ZYFAI_ENV=local

# Shared test wallet (same EOA on every environment)
PRIVATE_KEY=

# Partner API keys — one per environment (ZYFAI_ENV picks which is used)
LOCAL_ZYFAI_API_KEY=
STAGING_ZYFAI_API_KEY=
PRODUCTION_ZYFAI_API_KEY=

# Fresh-user tests: x-api-key for POST /admin/sdk-api-keys (must match server SDK_API_KEYS_ADMIN_API_KEY)
LOCAL_SDK_API_KEYS_ADMIN_API_KEY=
STAGING_SDK_API_KEYS_ADMIN_API_KEY=
PRODUCTION_SDK_API_KEYS_ADMIN_API_KEY=